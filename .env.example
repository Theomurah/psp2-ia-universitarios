# =============================================================
# Frontend (apps/web/.env.local)
# =============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================
# Edge Functions (supabase/functions/.env)
# =============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — providers de chat completions (texto + visão)
#
# O provider é escolhido pelo PREFIXO do modelo (ver bloco "Modelos" abaixo).
# Cadastre só as chaves que for usar — pode misturar providers por estágio.
#
#   openai/<model>          → OPENAI_API_KEY      → api.openai.com
#   anthropic/<model>       → ANTHROPIC_API_KEY   → api.anthropic.com
#   google/<model>          → GEMINI_API_KEY      → Gemini (OpenAI-compat)
#   openrouter/<prov>/<m>   → OPENROUTER_API_KEY  → openrouter.ai
#   <sem prefixo conhecido> → OPENROUTER_API_KEY  (gateway default)
#
# Regra: o prefixo nativo (openai/anthropic/google) só é usado SE a chave dele
# estiver setada; senão a string completa cai no OpenRouter. Assim, manter só o
# OPENROUTER_API_KEY preserva 100% o comportamento original.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
#
# (Avançado) Endpoint custom OpenAI-compatible para modelos SEM prefixo
# conhecido. Use só se não der pra rotear pelo prefixo acima.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Google OAuth (necessário só para Drive Export — H6 Sprint 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================
# Modelos LLM por estágio do pipeline (todos OPCIONAIS)
# =============================================================
# O PREFIXO do modelo define o provider/chave (ver bloco LLM acima).
# Sem env var, usa o default em packages/shared/src/constants.ts (OpenRouter).
#
# IMPORTANTE: com provider NATIVO os IDs são os nativos do provider, não os do
# catálogo OpenRouter. Ex: Sonnet 4.6 → OpenRouter "anthropic/claude-sonnet-4.6"
# (ponto) vs Anthropic direto "anthropic/claude-sonnet-4-6" (traço).
#
# Exemplo OpenAI direto (precisa de OPENAI_API_KEY):
#   MODEL_CLASSIFY=openai/gpt-5-mini
#   MODEL_SYNTHESIZE=openai/gpt-5-mini
#   MODEL_COMPRESS_COMPACT=openai/gpt-5-mini
#   MODEL_COMPRESS_COLA=openai/gpt-5.4-mini
#   MODEL_JUDGE=openai/gpt-5-mini
#   VISION_MODEL=openai/gpt-5.4-mini
#
# Exemplo Anthropic direto (precisa de ANTHROPIC_API_KEY, IDs nativos):
#   MODEL_SYNTHESIZE=anthropic/claude-haiku-4-5
#   VISION_MODEL=anthropic/claude-sonnet-4-6
#
# Exemplos via OpenRouter (default, prefixo do catálogo OpenRouter):
#   anthropic/claude-haiku-4.5
#   openai/gpt-4o-mini          (sem OPENAI_API_KEY → cai no OpenRouter)
#   deepseek/deepseek-chat-v3
#   google/gemini-2.0-flash-exp
# =============================================================
MODEL_CLASSIFY=
MODEL_SYNTHESIZE=
MODEL_COMPRESS_COMPACT=
MODEL_COMPRESS_COLA=
MODEL_JUDGE=

# Teto de tokens de SAÍDA por chamada do pipeline (cost guard). Vale como teto:
# nunca eleva o budget do estágio, só corta. Vazio = default 8192.
# Ex: cap agressivo pra controlar custo num provider caro (OpenAI direto):
#   LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_OUTPUT_TOKENS=

# =============================================================
# Vision (OCR) — modelo multimodal pra imagens (T13)
# =============================================================
# Aceita QUALQUER modelo vision-capable do OpenRouter.
# Lista filtrada: https://openrouter.ai/models?modality=image
#
# Exemplos:
#   anthropic/claude-sonnet-4.6              (default, melhor pra manuscrito)
#   google/gemini-2.0-flash-exp              (mais barato, rápido)
#   openai/gpt-4o                            (alternativa balanceada)
#   qwen/qwen-2-vl-72b-instruct              (open-source forte)
#   meta-llama/llama-3.2-90b-vision-instruct (open-source grande)
#
# Aliases legados aceitos: "claude" | "gemini" | "gpt-4o" | "qwen" | "llama"
VISION_MODEL=

# (Legado — use VISION_MODEL se possível)
VISION_PROVIDER=
