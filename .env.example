# =============================================================
# Frontend (apps/web/.env.local)
# =============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================
# Edge Functions (supabase/functions/.env)
# =============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — única chave necessária para LLM (texto + visão)
OPENROUTER_API_KEY=

# Google OAuth (necessário só para Drive Export — H6 Sprint 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================
# Modelos LLM por estágio do pipeline (todos OPCIONAIS)
# =============================================================
# Cada estágio aceita QUALQUER modelo do catálogo OpenRouter.
# Sem env var, usa o default em packages/shared/src/constants.ts.
# Lista completa de modelos: https://openrouter.ai/models
#
# Exemplos válidos:
#   anthropic/claude-haiku-4.5
#   anthropic/claude-sonnet-4.6
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   deepseek/deepseek-chat-v3
#   google/gemini-2.0-flash-exp
#   google/gemini-2.0-pro-experimental
#   meta-llama/llama-3.3-70b-instruct
#   qwen/qwen-2.5-72b-instruct
# =============================================================
MODEL_CLASSIFY=
MODEL_SYNTHESIZE=
MODEL_COMPRESS_COMPACT=
MODEL_COMPRESS_COLA=
MODEL_JUDGE=

# =============================================================
# Vision (OCR) — modelo multimodal pra imagens (T13)
# =============================================================
# Aceita QUALQUER modelo vision-capable do OpenRouter.
# Lista filtrada: https://openrouter.ai/models?modality=image
#
# Exemplos:
#   anthropic/claude-sonnet-4.6              (default, melhor pra manuscrito)
#   google/gemini-2.0-flash-exp              (mais barato, rápido)
#   openai/gpt-4o                            (alternativa balanceada)
#   qwen/qwen-2-vl-72b-instruct              (open-source forte)
#   meta-llama/llama-3.2-90b-vision-instruct (open-source grande)
#
# Aliases legados aceitos: "claude" | "gemini" | "gpt-4o" | "qwen" | "llama"
VISION_MODEL=

# (Legado — use VISION_MODEL se possível)
VISION_PROVIDER=
