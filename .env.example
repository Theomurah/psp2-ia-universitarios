# =============================================================
# Frontend (apps/web/.env.local)
# =============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================
# Edge Functions (supabase/functions/.env)
# =============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vision provider para OCR de imagens (T13)
# Decisão de qual usar em produção AINDA NÃO está fechada — pode trocar a qualquer momento.
# Aceito: "claude" (default, melhor pra manuscrito) | "gemini" (mais barato e rápido)
VISION_PROVIDER=claude
